<div class="card">
  <dl>
    <dt>Status</dt><dd><span class="badge {{request.status}}" data-field="status">{{request.statusLabel}}</span></dd>
    {{#if request.nfseNumber}}
    <dt>NFS-e</dt><dd data-field="nfseNumber">{{request.nfseNumber}}</dd>
    <dt>Código de verificação</dt><dd data-field="nfseVerificationCode">{{request.nfseVerificationCode}}</dd>
    <dt>Emitida em</dt><dd>{{request.nfseIssuedAt}}</dd>
    {{/if}}
    {{#if request.failureReason}}
    <dt>Motivo da falha</dt><dd data-field="failureReason">{{request.failureReason}}</dd>
    {{/if}}
  </dl>
  {{#if request.canDispatch}}
  <form method="post" action="/solicitacoes/{{request.id}}/emitir"><p><button class="btn" type="submit">Emitir</button></p></form>
  {{/if}}
  {{#if request.canReprocess}}
  <form method="post" action="/solicitacoes/{{request.id}}/reprocessar"><p><button class="btn" type="submit">Reprocessar</button> <span class="muted">Reenvia com o mesmo RPS: nunca gera uma segunda NFS-e.</span></p></form>
  {{/if}}
</div>
<div class="card">
  <h2 style="font-size:16px;margin:0 0 8px">Linha do tempo</h2>
  {{#if request.timeline.length}}
  <table>
    <tr><th>Quando</th><th>Evento</th><th>Tentativa</th><th>Detalhe</th></tr>
    {{#each request.timeline}}
    <tr><td>{{occurredAt}}</td><td>{{label}}</td><td>{{attempt}}</td><td>{{detail}}</td></tr>
    {{/each}}
  </table>
  {{else}}
  <p class="muted">Nenhum evento recebido do Robô de Emissão ainda.</p>
  {{/if}}
</div>
