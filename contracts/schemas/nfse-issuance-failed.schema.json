{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfse-poc.example/schemas/nfse-issuance-failed.schema.json",
  "title": "NfseIssuanceFailed",
  "description": "Issuance failed for good: a business error, or transient retries exhausted.",
  "type": "object",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "NfseIssuanceFailed"
    },
    "version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "issuanceRequestId",
        "rps",
        "attempt",
        "errorCategory",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "issuanceRequestId": {
          "$ref": "common.schema.json#/$defs/issuanceRequestId"
        },
        "rps": {
          "$ref": "common.schema.json#/$defs/rps"
        },
        "attempt": {
          "$ref": "common.schema.json#/$defs/attempt"
        },
        "errorCategory": {
          "$ref": "common.schema.json#/$defs/errorCategory"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "$ref": "common.schema.json#/$defs/failureArtifacts"
        }
      }
    }
  }
}