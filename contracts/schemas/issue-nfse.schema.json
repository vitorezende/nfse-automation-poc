{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfse-poc.example/schemas/issue-nfse.schema.json",
  "title": "IssueNfse",
  "description": "Command asking the Robô de Emissão to issue one NFS-e. Carries a credential reference, never a password.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "IssueNfse" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["issuanceRequestId", "rps", "prestador", "tomador", "servico", "amount", "competencia", "discriminacao"],
      "additionalProperties": false,
      "properties": {
        "issuanceRequestId": { "$ref": "common.schema.json#/$defs/issuanceRequestId" },
        "rps": { "$ref": "common.schema.json#/$defs/rps" },
        "prestador": {
          "type": "object",
          "required": ["cnpj", "credentialRef"],
          "additionalProperties": false,
          "properties": {
            "cnpj": { "$ref": "common.schema.json#/$defs/cnpj" },
            "credentialRef": { "type": "string", "minLength": 1, "description": "Key resolved by the robot's own secret store." }
          }
        },
        "tomador": {
          "type": "object",
          "required": ["cnpj", "name"],
          "additionalProperties": false,
          "properties": {
            "cnpj": { "$ref": "common.schema.json#/$defs/cnpj" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "servico": {
          "type": "object",
          "required": ["code", "description", "issRate"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "issRate": { "type": "number", "minimum": 0, "maximum": 1, "description": "ISS rate as a fraction, e.g. 0.05 for 5%." }
          }
        },
        "amount": { "$ref": "common.schema.json#/$defs/money" },
        "competencia": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$", "description": "Month/year of the service, YYYY-MM." },
        "discriminacao": { "type": "string", "minLength": 1 }
      }
    }
  }
}
